{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["grype"],
  "workspaces": {
    ".": {
      "entry": ["stylelint.config.mjs"],
      "project": [
        "**/*.{js,cjs,mjs,ts,cts,mts}",
        "!packages/**",
        "!examples/**",
        "!eval/**",
        "!.trunk/**",
        "!node_modules/**"
      ]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "examples/*": {
      "project": ["src/**/*.ts"]
    },
    "eval/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/ontology-server": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@ladybugdb/core"]
    }
  }
}
